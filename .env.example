# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCS_WAREHOUSE_PATH=gs://your-gcs-bucket-name/warehouse
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── BigQuery ──────────────────────────────────────────────────────────────────
BQ_DATASET=nyc_taxi_trust
BQ_LOCATION=US

# ── Iceberg ───────────────────────────────────────────────────────────────────
ICEBERG_CATALOG=nyc_taxi
ICEBERG_DATABASE=yellow_taxi
ICEBERG_TABLE=trips

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Comma-separated list of year-month pairs to ingest
INGEST_TARGETS=2015-01,2017-01,2019-01,2022-01
